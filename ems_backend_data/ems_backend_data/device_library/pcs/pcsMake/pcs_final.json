  "44801": {
    "name": "bms_status_word",
    "alias": "bms_status_word",
    "dataType": "int16",
    "min": 0,
    "max": 65535,
    "scaling": 1,
    "unit": "",
    "type": "alarm",
    "fc": 3,
    "srno": 0,
    "register": 44801,
    "word_swap": "big_endian",
    "byte_swap": "big_endian",
    "enable": true,
    "alarmType": "bitwise",
    "bitMap": {
      "0": {
        "alias": "BMS Loss of Communication"
      },
      "1": {
        "alias": "BMS Fault"
      },
      "2": {
        "alias": "SOC Upper Limit Exceeded"
      },
      "3": {
        "alias": "SOC Lower Limit Exceeded"
      },
      "4": {
        "alias": "BMS Charge Prohibited"
      },
      "5": {
        "alias": "BMS Discharge Prohibited"
      },
      "6": {
        "alias": "Initialization Status"
      },
      "7": {
        "alias": "BMS Alarm"
      },
      "8": {
        "alias": "BMS Charge/Discharge Prohibited"
      }
    }
  },
